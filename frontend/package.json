{
  "name": "cipherleaf-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "bench": "node --experimental-strip-types --expose-gc tests/performance.bench.ts && npm run bench:editor",
    "test": "node --test --experimental-strip-types tests/*.test.ts && npm run coverage",
    "coverage": "c8 --all --src src --extension .ts --extension .tsx --exclude 'src/vite-env.d.ts' --exclude 'tests/**' --exclude 'bindings/**' --reports-dir ../.ouro/quality/coverage/frontend --reporter=text --reporter=lcov --check-coverage --lines=85 node --enable-source-maps node_modules/vite-node/dist/cli.mjs --config vite.config.ts tests/coverage.tsx",
    "preview": "vite preview",
    "bench:editor": "node node_modules/vite-node/dist/cli.mjs --config vite.config.ts tests/editorInteraction.bench.tsx"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@lezer/highlight": "^1.2.3",
    "@wailsio/runtime": "3.0.0-alpha.95",
    "codemirror": "^6.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-test-renderer": "^18.0.7",
    "@vitejs/plugin-react": "^6.0.0",
    "c8": "^12.0.0",
    "eslint": "10.11.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.9",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.70.1",
    "vite": "^8.0.5",
    "vite-node": "^6.0.0"
  }
}
