<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="cipherleaf"
        Arguments=""
        InstallLocation="C:\Program Files\vbenevides\Cipherleaf">
    </Installer>
    <PackageInformation
        PackageName="Cipherleaf"
        PackageDisplayName="Cipherleaf"
        PublisherName="CN=vbenevides"
        PublisherDisplayName="vbenevides"
        Version="0.1.0.0"
        PackageDescription="Local-first encrypted Markdown notes">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.vbenevides.cipherleaf"
                Description="Local-first encrypted Markdown notes"
                DisplayName="Cipherleaf"
                ExecutableName="cipherleaf"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Cipherleaf</DisplayName>
            <PublisherDisplayName>vbenevides</PublisherDisplayName>
            <Description>Local-first encrypted Markdown notes</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="cipherleaf.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
