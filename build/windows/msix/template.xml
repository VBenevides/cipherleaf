<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="encrypted-markdown-vault"
        Arguments=""
        InstallLocation="C:\Program Files\wdtg\Encrypted Markdown Vault">
    </Installer>
    <PackageInformation
        PackageName="Encrypted Markdown Vault"
        PackageDisplayName="Encrypted Markdown Vault"
        PublisherName="CN=wdtg"
        PublisherDisplayName="wdtg"
        Version="0.1.0.0"
        PackageDescription="Local-first encrypted Markdown notes">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.wdtg.encrypted-markdown-vault"
                Description="Local-first encrypted Markdown notes"
                DisplayName="Encrypted Markdown Vault"
                ExecutableName="encrypted-markdown-vault"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Encrypted Markdown Vault</DisplayName>
            <PublisherDisplayName>wdtg</PublisherDisplayName>
            <Description>Local-first encrypted Markdown notes</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="encrypted-markdown-vault.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
